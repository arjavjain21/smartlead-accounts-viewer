# Copy this file to secrets.toml and fill in your actual values
# DO NOT commit secrets.toml to version control

# SmartLead API Bearer Token (for accounts endpoint)
SMARTLEAD_BEARER_TOKEN = "your_bearer_token_here"

# SmartLead API Key (for clients endpoint)
# Format: your_uuid_your_api_key
# Example: 2fbf4f7d-44af-4ff1-8e25-5655f5483fd0_94zyakr
SMARTLEAD_API_KEY = "your_api_key_here"

# App Password
APP_PASSWORD = "changeMe"
